# 复制为 deploy/.env 后按需修改；start.sh 会自动读取
PORT=8770
HOST=0.0.0.0

# 容量
MAX_PLAYERS=24        # 单分线人数
LANES=4               # 每房间分线数
MAX_CONNS=512         # 全局在连 WebSocket
MAX_PER_IP=8          # 单 IP 在连数（防单机刷房）
SLOT_TTL_S=30         # 断线重连槽位保留秒数
IDLE_KILL_S=15        # 从未握手的连接回收秒数

# 有 Nginx / Caddy 前置时设为 1，用于按 X-Forwarded-For 统计真实 IP
# TRUST_PROXY=1

# 直接对外提供 wss（浏览器以 https 页面访问时必须 wss）
# TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem

# 关闭周期状态日志
# QUIET=1

# 账号 / 进度 / 留言石碑 / 分线世界状态都存在这一个 SQLite 文件里。
# 留空 = 只存内存：联机照常，但重启后所有人的旅程清零。目录需对运行用户可写
# （systemd 单元里 ProtectHome=read-only，别放 /home 下；打不开会退回内存模式并打一行日志）。
# 用 server/cli.js 做封禁/查档案/看举报时也要带上同一个 AW_DB。
AW_DB=/var/lib/anime-world/world.db

# 世界难度与权威上限（按每条分线计）
# KING_HP=60          # 史莱姆王权威血量：多人一起磨，单人约 12 剑
# KING_HIT=8          # 单跳封顶伤害：改本地内存秒杀失效
# MAX_SHARDS=60       # 每条线记录的已采碎片数上限
# 史莱姆潮：这条分线上有两个人以上才开潮，第一波也要等一个 TIDE_MS（刚碰面就被人包围不好看）
# TIDE_MS=150000      # 压下一波之后，下一波最早什么时候再来（毫秒）
# TIDE_HP=40          # 池子基数：每多一个人（第三起）再加 60% 的基数
# TIDE_HIT=8          # 单跳进池封顶：星屑弹满蓄暴击也吃这一条，改不动池子就刷不动波
# TIDE_GEM=5          # 压下一波，这条线上每个有身份的旅人各分几枚星尘
# SPEED_LIMIT=20      # 位移合理性 u/s，超过即丢帧（冲刺+滑翔峰值约 14，留了余量）
# WEATHER_MS=240000   # 每条分线隔多久换一次天气（默认 4 分钟）。有人嫌雨吵可以调长，客户端没有改天气的入口
# WEATHER_PIN=        # 把天气钉死：clear|petal|rain|fog|meteor（演示服或拍宣传片用）。钉住就不再轮转，这一种也会随快照落进库
# MSG_RATE=60         # 入站消息/秒（令牌桶），超限拉黑 30s
# CHAT_RATE=1.2       # 聊天条/秒
